[Unit]
Description=MiaoImg outbound transport for the US model gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=miaoimg-egress
Group=miaoimg-egress
StateDirectory=miaoimg-egress
StateDirectoryMode=0750
ExecStart=/opt/miaoimg-ops/bin/mihomo -d /var/lib/miaoimg-egress -f /etc/miaoimg-egress/config.yaml
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/miaoimg-egress

[Install]
WantedBy=multi-user.target
