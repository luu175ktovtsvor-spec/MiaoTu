[Unit]
Description=MiaoImg native primary application services
After=network-online.target miaoimg-catalog.service postgresql.service redis-server.service
Wants=network-online.target miaoimg-catalog.service postgresql.service redis-server.service
[Service]
Type=simple
User=miaoimg
Group=miaoimg
WorkingDirectory=/opt/miaoimg/current
EnvironmentFile=/etc/miaoimg/main.env
Environment=NODE_OPTIONS=--use-env-proxy
ExecStartPre=/opt/miaoimg/node-v22.23.4-linux-x64/bin/node /opt/miaoimg/current/scripts/check-data-services.ts
ExecStartPre=/opt/miaoimg/node-v22.23.4-linux-x64/bin/node /opt/miaoimg/current/scripts/check-server-modules.ts
ExecStart=/opt/miaoimg/node-v22.23.4-linux-x64/bin/node /opt/miaoimg/current/web/scripts/with_api.ts preview
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=180
KillMode=mixed
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/miaoimg/.oip/runtime-data /opt/miaoimg/media /opt/miaoimg/catalog /var/lib/miaoimg
ReadOnlyPaths=/opt/miaoimg/secrets /opt/miaoimg/images /opt/miaoimg/previews
[Install]
WantedBy=multi-user.target
