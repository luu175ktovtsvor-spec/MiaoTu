location ^~ /__miaoimg-provider/ { allow __US_ORIGIN_IP__; deny all; proxy_pass http://127.0.0.1:17402; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_request_buffering off; proxy_buffering off; proxy_read_timeout 300s; proxy_send_timeout 300s; client_max_body_size 256m; access_log off; }
