[Unit]
Description=MiaoImg independent library content and video posters
After=network-online.target miaoimg-catalog.service
Wants=network-online.target

[Service]
Type=simple
User=miaoimg
Group=miaoimg
WorkingDirectory=/opt/miaoimg/library-content-service/current
Environment=OIP_API_PORT=4176
Environment=OIP_LIBRARY_CONTENT_PORT=4177
Environment=OIP_LIBRARY_CONTENT_ROOT=/opt/miaoimg/library-content
Environment=OIP_VIDEO_POSTER_CACHE=/opt/miaoimg/catalog/video-posters
ExecStart=/usr/bin/node server/library-content-api.js
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/opt/miaoimg/catalog/video-posters
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
