server {
 listen 80;
 server_name miaoimg.cn www.miaoimg.cn canvas.miaoimg.cn admin.miaoimg.cn;
 location /.well-known/acme-challenge/ { proxy_pass http://__US_ORIGIN_IP__; proxy_set_header Host $host; }
 location / { return 301 https://$host$request_uri; }
}
server {
 listen 443 ssl http2;
 server_name miaoimg.cn www.miaoimg.cn canvas.miaoimg.cn;
 ssl_certificate /etc/miaoimg/tls/fullchain.pem;
 ssl_certificate_key /etc/miaoimg/tls/privkey.pem;
 client_max_body_size 256m;
 location / { include /etc/nginx/snippets/miaoimg-relay-common.conf; proxy_set_header Host $host; }
}
server {
 listen 443 ssl http2;
 server_name admin.miaoimg.cn;
 ssl_certificate /etc/miaoimg/tls/fullchain.pem;
 ssl_certificate_key /etc/miaoimg/tls/privkey.pem;
 client_max_body_size 256m;
 include /etc/nginx/snippets/miaoimg-provider-relay.conf;
 location = /health { include /etc/nginx/snippets/miaoimg-relay-common.conf; proxy_set_header Host miaoimg.cn; }
 location ~ ^/(api/|mcp(?:/|$)|images/|previews/|thumbs/|_oip/sessions/|showcase/|landing/|desktop-downloads/) { include /etc/nginx/snippets/miaoimg-relay-common.conf; proxy_set_header Host miaoimg.cn; }
 location / { include /etc/nginx/snippets/miaoimg-relay-common.conf; proxy_set_header Host admin.miaoimg.cn; }
}
