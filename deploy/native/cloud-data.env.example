# Copy values into the private server environment; do not commit real passwords.
NODE_ENV=production
MIAO_EDITION=cn
MIAO_DATABASE_URL=postgresql://miaoimg_cn:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/miaoimg_cn
MIAO_DB_POOL_MAX=10
MIAO_REDIS_URL=redis://miaoimg_cn:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:6379/0
MIAO_REDIS_NAMESPACE=miaoimg:cn
# Required for the existing China database after its verified import.
# A new overseas database starts without a previous SQLite import.
MIAO_REQUIRE_IMPORTED_DATABASE=true
MIAO_CANDIDATE_MODE=false
