.git
.gitignore
.oip
vendor
.DS_Store
*.log
**/__pycache__
*.py[cod]
node_modules
web/node_modules
web/dist
backups
.playwright-cli
.env
.env.*
!.env.example
secrets
miaoimg-logo-source.png
db/*.db
db/*.db.gz
db/*.db-wal
db/*.db-shm

# Dataset assets come from GitHub Releases and the build re-fetches the archive
# itself (Dockerfile runs fetch_dataset.py --db-only). Without these two rules a
# checkout that already ran `npm run data:pull` ships several gigabytes to the
# Docker daemon as build context on every build.
images
previews
data/*
!data/dataset-manifest.json
# 本地运行产生的数据（例如在 web/ 目录直接起 API 时的管理库）绝不进镜像
web/data
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
artifacts
web/visual-seed.html
web/.vite
web/.cache

web/runtime/node_modules

# Local handbook videos and reference material
本地资料
docs/验收证据/

# Native business code is not cloud build input. These reviewed JSON assets are
# shared by the web/desktop Agent; keep their canonical paths, without copying
# the desktop application or its dependencies. Match deploy/cloud-showcase.filter.
desktop/
!desktop/renderer/src/library/showcase.json
!desktop/renderer/public/inspiration/prompts/*.json
!desktop/renderer/public/inspiration/translations/*.json
