# Provider credentials are read from secrets/ files (or the macOS Keychain for local compatibility).
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seedream-5-0-pro-260628
ARK_OUTPUT_FORMAT=png
ARK_RESPONSE_FORMAT=url
# 穗禾 SD 自营通道：视频与生图都走服务端穗禾 Key；不要把 Key 写入网页或安装包。
SUIHE_BASE_URL=https://api.suihemedia.cloud
# SUIHE_API_KEY is read from secrets/suihe-api-key
# 秘塔（metaso.cn）视频通道：MiniMax H3 + Seedance 2.0（MiniMax 兼容协议）
METASO_BASE_URL=https://metaso.cn
# METASO_API_KEY is read from secrets/metaso-api-key
ENABLE_MODEL_CALLS=true
# Public origin used by the image/admin APIs when they sit behind the web proxy.
OIP_PUBLIC_ORIGIN=https://your-domain.example
# Additional same-origin browser surfaces (comma-separated), for example:
# OIP_PUBLIC_ORIGINS=https://canvas.your-domain.example,https://admin.your-domain.example

# GPT Image models are served through the server's Sub2API OpenAI-compatible route.
# YUNSHU_API_KEY is read from secrets/yunshu-api-key
YUNSHU_BASE_URL=https://api.zzyppz.cn/v1
YUNSHU_OUTPUT_FORMAT=png
YUNSHU_RESPONSE_FORMAT=b64_json
YUNSHU_IMAGE_QUALITY=auto

# Optional default model. If omitted, the Ark Seedream model remains the default.
# OIP_DEFAULT_MODEL=gpt-image-2

# Optional: only enable the retained prompt archive API when you need it.
# OIP_ENABLE_ARCHIVE=true

# Administrator credentials are read from secrets/admin-email,
# secrets/admin-password and optional secrets/admin-token.
# Management API: fixed private port, proxied by the web process at /manage and
# /api/admin. Keep it loopback-only unless an explicit reverse-proxy boundary
# and the admin token are in place.
# OIP_ADMIN_HOST=127.0.0.1
# OIP_ADMIN_PORT=4184
# OIP_ADMIN_LOCAL_ONLY=true
OIP_MANAGEMENT_DB=/app/data/management.sqlite
# /app/data must be writable at runtime; the dataset mounts (/app/db, /app/images,
# /app/previews) can remain read-only.

# ZPAY / 易支付兼容充值。商户凭据分别放在 secrets/zpay-pid 和 secrets/zpay-key。
# ZPAY_ENABLED=true
# ZPAY_CID=
# 旧版本地 Markdown 凭据文件仍兼容；生产使用服务端密钥文件。
# OIP_PAYMENT_CREDENTIALS_FILE=secrets/zpay-api.md
# ZPAY_BASE_URL=https://zpayz.cn
# ZPAY_NOTIFY_URL=https://your-domain.example/api/imagine/payment/notify
# ZPAY_RETURN_URL=https://your-domain.example/api/imagine/payment/return
# ZPAY_PAYMENT_TYPES=alipay,wxpay
# ZPAY_ORDER_TTL_SECONDS=900
# 二维码图片缓存进管理 SQLite，随 OIP_MANAGEMENT_DB 持久化；本地假网关测试才开启回环地址。
# OIP_PAYMENT_QR_ALLOW_LOOPBACK=true
# 积分与人民币 1:1：默认 1 积分 = ¥1.00，充值区间 10–1000 积分；部署环境可覆盖。
# 积分与人民币 1:1：1 积分 = ¥1.00
# ZPAY_POINT_PRICE_CENTS=100
# ZPAY_MIN_POINTS=10
# ZPAY_MAX_POINTS=1000

# Google OAuth 2.0 / OpenID Connect server flow. Keep the client secret in the
# deployment environment; the callback URL must exactly match Google Cloud.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/imagine/oauth/google/callback

# QQ 互联 OAuth 2.0. QQ 互联后台的回调地址必须精确匹配此 URL；QQ 不提供已验证邮箱，
# 首次登录会用 QQ 身份创建账号，邮箱/密码登录仍需单独注册或后续绑定。
# QQ_OAUTH_APP_ID=
# QQ_OAUTH_APP_KEY=
# QQ_OAUTH_REDIRECT_URI=https://your-domain.example/api/imagine/oauth/qq/callback
# QQ_OAUTH_SCOPE=get_user_info

# GitHub OAuth. A verified GitHub email is required before an account can be
# linked or created.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=https://your-domain.example/api/imagine/oauth/github/callback
# GITHUB_OAUTH_SCOPE=read:user user:email

# WeChat Open Platform website QR login. WeChat does not provide a verified
# email in this flow, so it creates a provider-only account on first login.
# WECHAT_OAUTH_APP_ID=
# WECHAT_OAUTH_APP_SECRET=
# WECHAT_OAUTH_REDIRECT_URI=https://your-domain.example/api/imagine/oauth/wechat/callback
# WECHAT_OAUTH_SCOPE=snsapi_login

# DingTalk OAuth 2.0. The provider profile may not contain an email; when it
# does, it is linked only if DingTalk marks it as verified.
# DINGTALK_OAUTH_CLIENT_ID=
# DINGTALK_OAUTH_CLIENT_SECRET=
# DINGTALK_OAUTH_REDIRECT_URI=https://your-domain.example/api/imagine/oauth/dingtalk/callback
# DINGTALK_OAUTH_SCOPE=openid

# Linux.do Connect OAuth 2.0. PKCE is enabled by default.
# LINUXDO_OAUTH_CLIENT_ID=
# LINUXDO_OAUTH_CLIENT_SECRET=
# LINUXDO_OAUTH_REDIRECT_URI=https://your-domain.example/api/imagine/oauth/linuxdo/callback
# LINUXDO_OAUTH_SCOPE=openid profile email
# LINUXDO_OAUTH_USE_PKCE=true

# Generic OpenID Connect. Issuer discovery supplies authorization, token,
# userinfo and JWKS endpoints unless an *_URL override is provided.
# OIDC_OAUTH_CLIENT_ID=
# OIDC_OAUTH_CLIENT_SECRET=
# OIDC_OAUTH_ISSUER_URL=https://id.example.com
# OIDC_OAUTH_REDIRECT_URI=https://miaoimg.cn/api/imagine/oauth/oidc/callback
# OIDC_OAUTH_PROVIDER_NAME=企业账号
# OIDC_OAUTH_SCOPE=openid profile email
# OIDC_OAUTH_USE_PKCE=true
# OIDC_OAUTH_REQUIRE_EMAIL_VERIFIED=false

# 工作区文件的字节存在磁盘上（数据库只留 path/mime/size/revision/storage 瘦索引）。
# 默认取 $OIP_DATA_DIR/media，未设 OIP_DATA_DIR 时是 ./data/media。
# OIP_MEDIA_ROOT=/app/media
# 线上由 nginx 用 X-Accel-Redirect 直出时打开（nginx 必须注入 X-Miaoimg-Media-Accel: 1
# 或在这里写 1）；本地开发不设即可，Node 会自己按 Range 读盘发送。
# OIP_MEDIA_ACCEL=1
# 磁盘权限档位：默认 private（目录 0700 / 文件 0600，只有属主能读）。
# 要让宿主机 nginx 用 X-Accel-Redirect 直出，设成 group（目录 0750 / 文件 0640），
# 并把 nginx 用户加进 node 的组：usermod -aG 1000 www-data && systemctl restart nginx。
# OIP_MEDIA_MODE=group
