{
  "name": "miaoimg-desktop",
  "productName": "妙图",
  "version": "3.1.8",
  "macCredentialProtection": "local-key",
  "description": "妙图创作画布",
  "author": "MiaoImg",
  "private": true,
  "type": "module",
  "main": ".app/desktop/main.js",
  "scripts": {
    "start": "npm run prepare:app && electron .",
    "verify:release-notes": "node scripts/verify-release-notes.ts",
    "prepare:app": "node scripts/prepare.ts",
    "package:mac": "npm run verify:release-notes && npm --prefix .. run verify:mcp && npm run prepare:app && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "package:windows": "npm run verify:release-notes && npm --prefix .. run verify:mcp && npm run prepare:app && electron-builder --win nsis zip --x64 --publish never"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@mozilla/readability": "0.6.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "html-encoding-sniffer": "7.0.0",
    "htmlparser2": "10.1.0",
    "intl-messageformat": "^10.7.16",
    "linkedom": "0.18.13",
    "marked": "18.1.0",
    "micromark": "4.0.3",
    "micromark-util-decode-string": "2.0.1",
    "proper-lockfile": "4.1.2",
    "puppeteer-core": "25.12.0",
    "turndown": "7.2.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "cn.miaoimg.desktop",
    "productName": "妙图",
    "directories": {
      "output": "release"
    },
    "files": [
      ".app/**",
      "!.app/**/{[nN][oO][dD][eE]_[mM][oO][dD][uU][lL][eE][sS],.[aA][pP][pP],[rR][uU][nN][tT][iI][mM][eE],[rR][eE][lL][eE][aA][sS][eE],.[tT][oO][oO][lL][sS],.[gG][iI][tT],.[hH][gG],.[sS][vV][nN],.[oO][iI][pP],.[cC][aA][cC][hH][eE],.[vV][iI][tT][eE],__[pP][yY][cC][aA][cC][hH][eE]__,[rR][eE][fF][eE][rR][eE][nN][cC][eE]-[sS][oO][uU][rR][cC][eE][sS],[sS][eE][cC][rR][eE][tT][sS],.[sS][sS][hH],.[aA][wW][sS],.[gG][nN][uU][pP][gG],.[kK][uU][bB][eE]}{,/**/*}",
      "!.app/{server,desktop}/{[dD][bB],[dD][aA][tT][aA],[wW][oO][rR][kK][sS][pP][aA][cC][eE],[bB][aA][cC][kK][uU][pP][sS],[aA][rR][tT][iI][fF][aA][cC][tT][sS],[cC][oO][vV][eE][rR][aA][gG][eE]}{,/**/*}",
      "!.app/**/{.[dD][sS]_[sS][tT][oO][rR][eE],[dD][eE][sS][kK][tT][oO][pP].[iI][nN][iI],.[nN][pP][mM][rR][cC],.[nN][eE][tT][rR][cC],.[pP][yY][pP][iI][rR][cC],.[gG][iI][tT]-[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS],.[yY][aA][rR][nN][rR][cC].[yY][mM][lL],[iI][dD]_[rR][sS][aA],[iI][dD]_[dD][sS][aA],[iI][dD]_[eE][cC][dD][sS][aA],[iI][dD]_[eE][dD]25519}",
      "!.app/**/*.{[dD][bB],[sS][qQ][lL][iI][tT][eE],[sS][qQ][lL][iI][tT][eE]3}{,-[wW][aA][lL],-[sS][hH][mM],-[jJ][oO][uU][rR][nN][aA][lL]}{,.[gG][zZ]}",
      "!.app/**/*.{[eE][nN][cC],[kK][eE][yY],[pP][eE][mM],[pP]12,[pP][fF][xX],[jJ][kK][sS],[kK][eE][yY][sS][tT][oO][rR][eE]}",
      "!.app/**/*.{[lL][oO][gG],[dD][oO][wW][nN][lL][oO][aA][dD],[tT][mM][pP],[bB][aA][kK],[oO][rR][iI][gG],[pP][yY][cC],[pP][yY][oO]}{,.*,-*}",
      "!.app/**/*~",
      "!.app/**/.[eE][nN][vV]",
      "!.app/**/.[eE][nN][vV].!([eE][xX][aA][mM][pP][lL][eE]|[sS][aA][mM][pP][lL][eE]|[tT][eE][mM][pP][lL][aA][tT][eE])",
      "!.app/desktop/{[cC][oO][mM][pP][uU][tT][eE][rR]-[aA][cC][cC][eE][sS][sS].[jJ][sS][oO][nN],[wW][iI][nN][dD][oO][wW].[jJ][sS][oO][nN]}",
      "!.app/desktop/[cC][aA][tT][aA][lL][oO][gG]-*.[jJ][sS][oO][nN]",
      "!.app/**/[sS][eE][tT][tT][iI][nN][gG][sS]/[pP][rR][oO][vV][iI][dD][eE][rR][sS].[jJ][sS][oO][nN]"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "identity": "-",
      "notarize": false,
      "entitlements": "assets/mac-entitlements.plist",
      "entitlementsInherit": "assets/mac-entitlements.plist"
    },
    "dmg": {
      "window": {
        "width": 620,
        "height": 420
      },
      "contents": [
        {
          "x": 160,
          "y": 180,
          "type": "file"
        },
        {
          "x": 460,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 310,
          "y": 330,
          "type": "file",
          "path": "assets/首次使用，请右键打开.command"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://miaoimg.cn/desktop-downloads/updates/"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "afterPack": ".app/desktop/scripts/windows-resources.js"
  }
}
