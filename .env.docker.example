# Local Docker runtime defaults. Copy to .env.docker when local credentials
# or model calls are needed. Never commit the copied file.
ENABLE_MODEL_CALLS=false
OIP_ADMIN_LOCAL_ONLY=true
OIP_ENABLE_ARCHIVE=true

# Optional server-side abuse brakes for replayed desktop/API requests. Defaults
# apply per account and per client address when these remain unset.
# MIAO_RATE_IMAGE_PER_MINUTE=12
# MIAO_RATE_VIDEO_PER_MINUTE=6
# MIAO_RATE_TEXT_PER_MINUTE=80
# MIAO_RATE_MEDIA_PER_MINUTE=12
# MIAO_RATE_AGENT_PER_MINUTE=40
# MIAO_RATE_MCP_PER_MINUTE=80
# MIAO_RATE_WEB_PER_MINUTE=80
# MIAO_RATE_PROVIDER_PER_MINUTE=20
# MIAO_MAX_ACTIVE_GENERATIONS_PER_USER=8

# To enable real generation locally, put provider keys in ./secrets/ and set:
# ENABLE_MODEL_CALLS=true
# The application reads ark-api-key, suihe-api-key, yunshu-api-key,
# grok-api-key and metaso-api-key from the mounted secrets directory; do not
# put keys here.

# 工作区文件的字节存在 /app/media（compose 里的 oip-media 卷），数据库只留瘦索引。
# 如果要让宿主机的 nginx 用 X-Accel-Redirect 直出这个目录（alias /app/media/），
# 把卷换成同路径的 bind mount 更省事，例如：/srv/miaoimg/media:/app/media
# OIP_MEDIA_ROOT=/app/media
# 要让宿主机 nginx 用 X-Accel-Redirect 直出，权限档位设成 group（目录 0750 / 文件 0640），
# 并把 nginx 用户加进 node 的组：usermod -aG 1000 www-data && systemctl restart nginx
# OIP_MEDIA_MODE=group
